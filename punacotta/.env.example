# Copy to .env.local for local dev (Vercel CLI reads this automatically)

# Neon / Supabase / any Postgres connection string
DATABASE_URL=postgres://user:password@host/dbname

# JWT signing secret — change this!
JWT_SECRET=change-this-to-a-long-random-string

# SMTP (leave blank to log emails to console in dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=yourpassword
# SMTP_FROM="Pun&Cotta" <hello@puncotta.com>
